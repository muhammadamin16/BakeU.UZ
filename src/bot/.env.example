# Copy to .env. Never commit the real token.
BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. Each admin must /start the bot.
ADMIN_IDS=
SITE_URL=https://bakeu.uz
TELEGRAM_URL=
INSTAGRAM_URL=
SUPPORT_EMAIL=
# true enables Telegram Mini App for HTTPS websites; false opens a normal link.
USE_WEB_APP=false
# Exact frontend origins, comma-separated; no wildcard. Local Vite is included below.
ALLOWED_ORIGINS=http://localhost:5173,https://bakeu.uz,https://www.bakeu.uz
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_PATH=./data/bakeu.sqlite
# Requests from a reverse proxy are NOT trusted for rate limits by default.
# Set true only with API_HOST=127.0.0.1 and the supplied Nginx configuration.
TRUST_PROXY=false
SESSION_HOURS=24
