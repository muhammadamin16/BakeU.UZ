# Copy to .env. Never commit the real token.
BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. Each admin must /start the bot.
ADMIN_IDS=5624322567
# npm run bot uses MINI_APP_URL; SITE_URL remains available for legacy website mode.
SITE_URL=https://bakeu-website-production.up.railway.app
# Optional override. Blank uses the BakeU Railway website domain.
MINI_APP_URL=
TELEGRAM_URL=https://t.me/bakeu_uz
INSTAGRAM_URL=https://www.instagram.com/bakeu.uz?rpxt=MXB0bDExZnN4anQ2aA%3D%3D&utm_source=qr
SUPPORT_EMAIL=bakeu@gmail.com
# Legacy bot:website behavior only; npm run bot always uses Mini App mode.
USE_WEB_APP=true
# Exact frontend origins, comma-separated; no wildcard. Local Vite is included below.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000,https://bakeu-website-production.up.railway.app,https://bakeu.uz,https://www.bakeu.uz
API_HOST=127.0.0.1
# Railway: set API_HOST=0.0.0.0, and use Railway PORT (leave API_PORT unset).
API_PORT=3001
# On Railway, attach a persistent volume and point DATABASE_PATH into it.
DATABASE_PATH=./data/bakeu.sqlite
# Requests from a reverse proxy are NOT trusted for rate limits by default.
# Set true only with API_HOST=127.0.0.1 and the supplied Nginx configuration.
TRUST_PROXY=false
SESSION_HOURS=24

# Shared Go/MongoDB orders integration. Disabled until the bridge contract is deployed.
TELEGRAM_ORDERS_ENABLED=false
GO_BACKEND_URL=
# Separate server-to-server secret; never a browser variable or BOT_TOKEN.
TELEGRAM_BRIDGE_TOKEN=
