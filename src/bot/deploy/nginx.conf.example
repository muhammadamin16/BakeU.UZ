# Place these locations INSIDE your existing HTTPS server {} for bakeu.uz.
# TLS/domain setup and your existing frontend root remain in your server block.
location /api/ {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 3m;
}
# Built Vite frontend (set root /opt/BakeU.UZ/dist in the server block):
location / {
    try_files $uri $uri/ /index.html;
}
