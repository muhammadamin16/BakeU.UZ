{
  "name": "bakeu-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bridge:check": "node --env-file-if-exists=.env scripts/check-bridge.mjs",
    "start": "node --env-file-if-exists=.env index.js",
    "check": "node --env-file-if-exists=.env index.js --check",
    "test": "node --test tests/*.test.js",
    "miniapp": "node --env-file-if-exists=.env index.js --miniapp",
    "miniapp:check": "node --env-file-if-exists=.env index.js --miniapp --check"
  }
}
