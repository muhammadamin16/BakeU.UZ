# Copy to .env.local in the repository root to enable server accounts.
# Vite proxies /api to the bot/account server on localhost:3001 in development.
# Production: use /api only with the included website gateway (npm start/Docker).
VITE_ACCOUNT_API_URL=/api
# Local Vite port. Copy this line to .env.local and restart npm run dev to change it.
# Default: 5173. Occupied/Windows-reserved ports fall back to an available port.
# Port 3001 is used by the bot API; automatic fallback skips it.
VITE_DEV_PORT=5173

# Optional: if BakeU Telegram bot API runs on Railway instead of localhost:
# VITE_BOT_API_PROXY_TARGET=https://YOUR-BOT-API.up.railway.app
# Set this in .env.local; restart Vite afterwards. Do NOT put the BOT_TOKEN here.
# Production: set VITE_ACCOUNT_API_URL to the full publicly reachable bot API
# base with /api suffix, e.g. https://YOUR-BOT-API.up.railway.app/api,
# unless /api is reverse proxied to this bot on the website host.

# Public Telegram bot username for the auth fallback link (without @).
# VITE_TELEGRAM_BOT_USERNAME=your_bakeu_bot

# Shared storefront/orders account backed by Go for website and Telegram Mini App.
# Use an HTTPS same-site API ending in /api or a same-origin /api proxy.
# VITE_GO_API_URL=
# Coordinated opt-in after Go AUTH_PHONE_ACCOUNTS and bot GO_ACCOUNTS_ENABLED.
# Uses the SAME Go session for /login, /register, /profile and /account/orders.
# Phone-only v2 requires matching backend structured-name/map contract and the
# reviewed staging email-index transition: docs/production/PHONE_ONLY_AUTH.md.
VITE_GO_PHONE_ACCOUNTS=false

# Optional standalone Go orders/proof page API override; never a service secret.
# VITE_GO_BACKEND_URL=https://YOUR-GO-BACKEND.up.railway.app/api
# Prefer VITE_GO_API_URL above when the shared browser-session API is configured.

# Production gateway runtime settings (NOT VITE_, never embedded in JavaScript).
# Exact private Go/Bot URLs may be used here with the services' actual PORTs.
WEB_GO_API_URL=https://bakeu-backend-production.up.railway.app/api
WEB_BOT_API_URL=https://bakeu-bot-production.up.railway.app/api
WEB_ALLOWED_ORIGINS=https://bakeu-website-production.up.railway.app
# Keep legacy until backups/inventory, Go+bot verification and a Go-enabled build.
WEB_ACCOUNTS_MODE=legacy
