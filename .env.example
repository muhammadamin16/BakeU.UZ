# Public browser settings. Copy to .env.local beside package.json.
VITE_API_URL=/api
VITE_MINIAPP_API_URL=/api
VITE_DEV_PORT=5173

# Vite forwards /api to an ALREADY RUNNING, separate Backend.
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:38119
# Optional separate Bot HTTP API for Telegram Mini App launch verification.
# VITE_MINIAPP_PROXY_TARGET=http://127.0.0.1:3001

# Optional npm start / Docker runtime proxy (not included in browser JavaScript).
# BACKEND_URL=https://your-backend.example
# BOT_API_URL=https://your-bot-api.example
# WEB_ALLOWED_ORIGINS=https://your-website.example
# PORT=8080
