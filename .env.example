# Copy to .env.local in the repository root to enable server accounts.
# Vite proxies /api to the bot/account server on localhost:3001 in development.
# Production: use the supplied Nginx /api reverse proxy on the same HTTPS domain.
VITE_ACCOUNT_API_URL=/api
# Local Vite port. Copy this line to .env.local and restart npm run dev to change it.
# Default: 5173. Occupied/Windows-reserved ports fall back to an available port.
# Port 3001 is used by the bot API; automatic fallback skips it.
VITE_DEV_PORT=5173
